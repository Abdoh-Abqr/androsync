<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AndroSyncApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroSyncRemote">

        <!--
          usesCleartextTraffic is set via the network security config below (not the
          manifest attribute) so we can scope it precisely: every AndroSync endpoint the
          app talks to (USB loopback via `adb reverse`, the Tailscale IP, and a plain LAN
          IP) is either localhost or a private/VPN network the user explicitly trusts,
          never the public internet. See network_security_config.xml for the rationale.
        -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AndroSyncRemote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PLAN.md task 20: keeps a sync job alive on screen off with a progress notification. -->
        <service
            android:name=".service.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- PLAN.md task 21: Quick Settings tile "AndroSync" - tap syncs every pair. -->
        <service
            android:name=".tile.SyncTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- PLAN.md task 21: home-screen widget with last result + "Sync now". -->
        <receiver
            android:name=".widget.SyncWidgetReceiver"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sync_widget_info" />
        </receiver>
    </application>

</manifest>
